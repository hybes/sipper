{
  "name": "sipper-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3100",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "prepare": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "owner:grant": "tsx --env-file-if-exists=.env scripts/grant-owner.ts",
    "test": "tsx --env-file-if-exists=.env scripts/test.ts",
    "test:messages-http": "tsx --env-file-if-exists=.env scripts/messages-http-smoke.ts",
    "test:android-portal": "tsx --env-file-if-exists=.env scripts/native-portal-smoke.ts android",
    "test:ios-portal": "tsx --env-file-if-exists=.env scripts/native-portal-smoke.ts ios",
    "test:windows-portal": "tsx --env-file-if-exists=.env scripts/native-portal-smoke.ts windows",
    "test:gateway": "tsx --env-file-if-exists=.env scripts/gateway-smoke.ts",
    "test:meetings": "tsx --env-file-if-exists=.env scripts/test.ts --meetings",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "worker:push": "tsx --env-file-if-exists=.env scripts/push-worker.ts",
    "worker:meeting": "tsx --env-file-if-exists=.env scripts/meeting-worker.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.5",
    "@better-auth/sso": "1.7.5",
    "@nuxt/ui": "4.11.1",
    "better-auth": "1.7.5",
    "livekit-client": "2.22.3",
    "livekit-server-sdk": "2.19.1",
    "nodemailer": "^7.0.0",
    "nuxt": "4.5.2",
    "pg": "8.23.0",
    "qrcode": "^1.5.4",
    "stripe": "22.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.135",
    "@livekit/rtc-node": "1.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0"
  }
}
