# Build products
/build/
/DerivedData/
/.build/
*.xcuserstate
xcuserdata/
/Sipper.xcodeproj/
/dist/

# Vendored PJSIP and Opus sources and build output (rebuild with scripts/build-pjsip.sh)
/vendor/pjproject-*/
/vendor/pjsip/
/vendor/opus-*/
/vendor/opus/
/vendor/*.tar.gz

# Extension packaging
/extension/dist/
/extension/*.zip
node_modules/

# Website (Cloudflare Workers) local state
/website/.wrangler/

.DS_Store

# Self-signed certificate generated by tools/sip-test-server.py
/tools/.sip-test-certs/

# Local credentials, account exports and signing material must never be published.
.env
.env.*
!.env.example
.dev.vars*
*.p12
*.p8
*.key
*.pem
*.mobileprovision
*.provisionprofile
/.claude/
/.codex/
/.agents/

# Windows app (windows/): dependencies, PJSIP build, engine binaries, packaged output
/windows/dist/
/windows/vendor/
/windows/engine/build/
/windows/build/licences/
/windows/tests/e2e/output/
