/vendor/pjproject-*/
/vendor/pjsip/
/vendor/opus-*/
/vendor/opus/
/vendor/*.tar.gz

# Extension packaging
/extension/dist/
/extension/*.zip
# Local promotional authoring workspace; reviewed website assets live in website/.
/marketing/
node_modules/

# Website (Cloudflare Workers) local state
/website/.wrangler/

.DS_Store

# Self-signed certificate generated by tools/sip-test-server.py
/tools/.sip-test-certs/

# Local credentials, account exports and signing material must never be published.
.env
.env.*
!.env.example
.dev.vars*
*.p12
*.p8
*.key
*.pem
*.mobileprovision
*.provisionprofile
*.jks
*.keystore
/.claude/
/.codex/
/.agents/

