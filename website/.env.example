# Local Worker testing only: copy to .dev.vars (ignored by Git).
# Production: set PORTAL_ORIGIN in wrangler.jsonc/deployment settings, and set
# SIPPER_EDGE_SHARED_SECRET with `wrangler secret put SIPPER_EDGE_SHARED_SECRET`.
# Never put the secret in wrangler.jsonc or a public client application.
# HTTPS origin of the management container, commonly a Cloudflare Tunnel hostname.
# No path, query, credentials or trailing fragment; must differ from sipper.dev.
PORTAL_ORIGIN=https://origin.example.invalid
# Independently generated random secret, at least 32 characters. Must exactly
# match portal's server-only environment. Blank leaves management unavailable.
SIPPER_EDGE_SHARED_SECRET=
