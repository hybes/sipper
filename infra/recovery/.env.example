# PostgreSQL client settings, separate from portal/.env.example.
# Populate a private file outside the repository and chmod 600 it.
PGHOST=database.example.invalid
PGPORT=5432
PGDATABASE=sipper
PGUSER=sipper
# The mounted .pgpass file must be readable by the container's chosen UID and
# mode 0600. Format: hostname:port:database:username:password (escape : and \).
# Use a backup role with SELECT on all required objects, or the database owner.
PGPASSFILE=/run/secrets/postgres.pgpass
PGSSLMODE=verify-full
PGSSLROOTCERT=/run/secrets/postgres-ca.crt
PGCONNECT_TIMEOUT=10

# Backup: mount public recipients only; the private age identity stays off-host.
# One age public recipient per line, generated from the escrowed recovery key.
SIPPER_BACKUP_RECIPIENTS=/run/secrets/backup-recipients.txt
# Change for each backup. Existing archives are never overwritten.
SIPPER_BACKUP_OUTPUT=/backups/sipper-YYYYMMDDTHHMMSSZ.dump.age

# Cold restore: fence former app/worker/gateway/Asterisk hosts and use a NEW,
# empty, isolated target with matching credentials above. The restored database
# stays under a persistent recovery hold; packaged services refuse startup.
# Reconcile post-snapshot access/billing/security changes, then use these same
# database settings with database-release.sh --reconciled. Release requires no
# age identity/archive mount. It cannot recover changes absent from the backup.
# This explicit name must equal PGDATABASE. The supplied default intentionally
# does not match the live database example; edit both before a planned restore.
SIPPER_RESTORE_DATABASE=sipper_restore
SIPPER_RESTORE_INPUT=/backups/sipper-YYYYMMDDTHHMMSSZ.dump.age
# Mount this only during recovery, read-only. Do not retain it on the backup host.
SIPPER_RESTORE_IDENTITY=/run/secrets/backup-identity.txt
