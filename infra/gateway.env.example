# Compose interpolation only. Populate outside the checkout, mode 0600.
# Asterisk: gateway/.env.example; controller: gateway/controller.env.example.
# Use independently tagged, tested images and retain their matching source/digests.
SIPPER_ASTERISK_IMAGE=sipper-asterisk:22.11.0
SIPPER_CONTROLLER_IMAGE=sipper-controller:local
SIPPER_ASTERISK_ENV_FILE=/etc/sipper/asterisk.env
SIPPER_CONTROLLER_ENV_FILE=/etc/sipper/controller.env
# Contains server.crt (full chain) and server.key, readable only by host operators
# and container UID/GID 10001. The directory must already exist; it is mounted ro.
SIPPER_GATEWAY_TLS_DIRECTORY=/etc/sipper/sip-tls

# The default is private host loopback. For a pilot, deliberately select the host
# interface that receives SIP/media and configure its firewall before publishing.
# Only SIP TLS and this UDP media range are published; ARI/AMI remain loopback
# inside Asterisk's network namespace. There is no unencrypted SIP listener.
SIPPER_GATEWAY_BIND_IP=127.0.0.1
SIPPER_GATEWAY_TLS_PORT=5061
# Compose supplies the SAME RTP values to Asterisk and the published UDP range.
# Complete RTP/RTCP pairs: even start, odd end, at least 1024. Size for call load.
SIPPER_GATEWAY_RTP_START=20000
SIPPER_GATEWAY_RTP_END=20199
# NAT address/network settings remain in the private Asterisk environment.
# The portal's advertised SIP hostname/port must match clients' reachable address
# and certificate. This file does not provision DNS, TLS, NAT or firewall rules.

# Private database/upstream CA mounts may be added in a local Compose override;
# keep the corresponding paths in asterisk.env/controller.env. Never disable
# certificate verification or mount a private TLS key into the controller.
