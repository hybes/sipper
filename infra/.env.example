# Compose interpolation only. Application settings are in portal/.env.example.
# Use an absolute, private path outside the checkout; chmod 600 the populated file.
# compose.app.yml uses raw env-file parsing: no surrounding quotes around values,
# no shell expansion, and use literal \n inside PEM values as portal/.env.example describes.
SIPPER_APP_ENV_FILE=/etc/sipper/portal.env
# Tag the tested image with an immutable release/commit identifier before deployment.
SIPPER_APP_IMAGE=sipper-platform:local
# This listener always binds to 127.0.0.1. Terminate HTTPS at a trusted reverse proxy.
SIPPER_ORIGIN_PORT=3101
# Optional compose.tunnel.yml overlay. The remotely managed Cloudflare Tunnel
# token is a FILE, not an environment value or command-line argument. It is
# distinct from SIPPER_EDGE_SHARED_SECRET. Make it readable by UID/GID 65532
# only (e.g. owner 65532:65532 and mode 0400 on the deployment host).
SIPPER_TUNNEL_TOKEN_FILE=/etc/sipper/tunnel-token

# Optional self-hosted meetings overlay (--profile meetings). These are private
# file paths, not inline credentials; see docs/MEETINGS.md for the full topology.
SIPPER_MEETING_CONFIG_FILE=/etc/sipper/livekit.yaml
SIPPER_MEETING_PROXY_ENV_FILE=/etc/sipper/meeting-proxy.env
SIPPER_MEETING_UID=1000
SIPPER_MEETING_GID=1000
SIPPER_MEETING_SIGNAL_PORT=17881
# The signalling process reuses the gateway Node image, without Asterisk/DB keys.
SIPPER_CONTROLLER_IMAGE=sipper-controller:local
