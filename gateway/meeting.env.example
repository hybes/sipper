# This signalling process has no SFU API secret and no database credentials.
# In the combined application/meetings Compose project:
SIPPER_MEETING_INTERNAL_URL=http://meetings-media:7880
SIPPER_MEETING_ADMISSION_URL=http://portal:3100/api/meetings/admission
# Match the portal's separate admission secret. Copy the populated file outside
# the repository, mode 0600. Do not put real keys into commands or screenshots.
SIPPER_MEETING_ADMISSION_KEY=replace-with-a-separate-random-secret-of-at-least-32-characters
# Existing portal origin protection remains enforced. For the direct private
# portal URL above, match its SIPPER_EDGE_SHARED_SECRET; leave empty in local dev.
SIPPER_EDGE_SHARED_SECRET=replace-with-the-existing-portal-origin-secret
# Local standalone use defaults to 127.0.0.1:7881; Compose sets 0.0.0.0:7881
# behind a loopback-only published port and your WSS reverse proxy.
HOST=127.0.0.1
PORT=7881
