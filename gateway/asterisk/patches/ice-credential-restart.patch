+/* Remote credential changes regenerate local credentials before the SDP answer.
+ * Reusing an unfinished session would authenticate with the previous password. */
+static int ice_has_current_credentials(struct ast_rtp *rtp)
+{
+	return !pj_strcmp2(&rtp->ice->real_ice->rx_ufrag, rtp->local_ufrag)
+		&& !pj_strcmp2(&rtp->ice->real_ice->rx_pass, rtp->local_passwd);
+}
