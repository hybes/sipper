# Local gateway pilot. Calling is verified with an isolated TLS/SRTP SIP fixture.
# Android incoming/outgoing encrypted media packets are emulator-verified. Native
# push, physical audio, broader interoperability and host-failure recovery are in progress.
# Never reuse the portal database owner or a real PBX credential here.
# Pair deployment uses infra/compose.gateway.yml and infra/gateway.env.example.
# Compose forces private loopback ARI/AMI and supplies the published RTP range.

# PostgreSQL host reachable from the gateway container. All values below must
# be <=63 characters because of Asterisk's native PostgreSQL driver.
SIPPER_DB_HOST=postgres.example.invalid
SIPPER_DB_PORT=5432
SIPPER_DB_NAME=sipper
SIPPER_DB_USER=sipper_gateway
# A dedicated role with USAGE on public and SELECT on ONLY:
# gateway_ps_endpoints, gateway_ps_auths, gateway_ps_aors.
# No writes and no access to gateway_credentials, sip_configurations or auth tables.
# Generate independently: openssl rand -base64 32. Quotes, whitespace and semicolons
# are not accepted by the configuration renderer. Do not commit the populated file.
SIPPER_DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_ROLE_PASSWORD

# libpq settings: verify the database certificate and hostname in production.
PGSSLMODE=verify-full
# Optional private database CA, mounted read-only inside the container:
# PGSSLROOTCERT=/run/database-ca/root.crt
# Only the isolated local smoke test uses PGSSLMODE=disable against its test DB.

# The service listens on TLS 5061 only. Mount a directory at /run/tls containing
# server.crt (certificate plus chain) and server.key. The unprivileged container
# user (UID/GID 10001) must be able to read them. Use a public CA certificate for
# released apps; the test harness trusts its own disposable CA explicitly.
# No plain SIP listener or shared client password is enabled.
# The gateway requires SHA-256 SIP digest and SRTP. Never change either policy
# merely to make an unsupported client appear connected.

# RTP/RTCP UDP range, inclusive. Start must be even and end odd, at least 1024.
# Forward this exact range without changing port numbers when using one-to-one
# NAT. Allow it only on the intended media ingress; ARI stays private.
SIPPER_RTP_START=20000
SIPPER_RTP_END=20199
# Leave PUBLIC_IP and LOCAL_IP blank for directly reachable media. The shared
# LOCAL_NETWORKS list may still be needed when only signalling is behind NAT.
# For one-to-one NAT, supply the reachable literal IP (no hostname), the matching
# internal interface IP and comma-separated local CIDRs for upstream peers.
# Example values: 198.51.100.10, 192.0.2.20, 192.0.2.0/24.
# If PUBLIC_IP is set and LOCAL_IP is blank, resolve the container hostname to
# its IPv4 interface. Set LOCAL_IP explicitly on multihomed/IPv6 deployments.
# PUBLIC_IP and LOCAL_IP must use the same family; scoped addresses are rejected.
# The private ICE candidate is replaced. Local upstream routes retain their own
# address through LOCAL_NETWORKS. This does not configure the host firewall/NAT.
# A TCP proxy/container bridge forwarding external clients must not be classified
# as a local upstream peer. That would leave a private SDP default address paired
# with a public-only ICE candidate, which clients can reject as an ICE mismatch.
SIPPER_MEDIA_PUBLIC_IP=
SIPPER_MEDIA_LOCAL_IP=
SIPPER_MEDIA_LOCAL_NETWORKS=
# SIP signalling behind NAT also needs its reachable address and TLS port.
# These rewrite the dialog Contact/Via so clients can send BYE and re-INVITE back
# to this gateway. A working REGISTER/media stream alone does not prove this path.
# Use a literal public IP; no hostname, URI or scoped IPv6 address. The external
# port may differ from the container's 5061; forward it to that TLS listener.
# Leave both blank for directly reachable signalling. With an IP and blank port,
# the external port defaults to 5061. Port alone is rejected.
# SIPPER_MEDIA_LOCAL_NETWORKS applies to BOTH media and signalling NAT rewrites.
# Keep external-client forwarding proxies outside those trusted local networks.
# Clients still verify TLS certificates; use a certificate valid for their gateway
# identity. These values do not change the portal's advertised gateway hostname.
SIPPER_SIGNAL_PUBLIC_IP=
SIPPER_SIGNAL_PUBLIC_PORT=
# The optional Android smoke test publishes host-loopback TCP 25061 for SIP and
# UDP 27000-27031 for media. Its media candidate is the emulator's 10.0.2.2 host
# alias; its SIP Contact is 127.0.0.1:25061 via adb reverse. Never use these
# addresses for deployed clients. The fixed test ports must be free; binds fail
# rather than replacing an existing service or emulator forwarding rule.

# Optional private CA for upstream SIP peers. The default is the system CA bundle.
# Mount this read-only and keep verification enabled. The local fixture uses its
# disposable certificate here; production must trust the actual provider's CA.
SIPPER_UPSTREAM_CA_FILE=/etc/ssl/certs/ca-certificates.crt

# ARI is the privileged, private connection between controller and Asterisk.
# Set the same independently generated password on both processes (32+ characters;
# openssl rand -base64 32). It must satisfy the renderer's safe-character rules.
# Blank leaves ARI disabled. Never publish port 8088 to a public interface.
SIPPER_ARI_PASSWORD=
# Bind Asterisk ARI to loopback; controller should share its network namespace.
# The isolated smoke test binds 0.0.0.0 inside its container and publishes only
# to host loopback. Private deployments must provide equivalent isolation.
SIPPER_ARI_BIND=127.0.0.1
SIPPER_ARI_URL=http://127.0.0.1:8088/ari

# Optional upstream PBX registration observations. Set the SAME independently
# generated 32+ character password on Asterisk and its controller. This is a local
# service secret, not a provider API key. Blank disables AMI/status polling; the
# portal shows Not reported (or Stale for a previous observation), never success.
# Recovery requires a fresh snapshot even if the controller identity is unchanged.
# Apply portal migrations through 022 and update portal/controller together.
# Use openssl rand -base64 32 and the same renderer-safe character rules as ARI.
# AMI is privileged: its reporting permission also permits some PJSIP actions.
# Never expose 5038 publicly or place this password in native apps/the browser.
# Prefer a shared network namespace and loopback. The smoke test uses a disposable
# container listener and publishes it only on host loopback. Do not copy its bind
# override into a public deployment. AMI HTTP access remains disabled.
SIPPER_AMI_PASSWORD=
SIPPER_AMI_BIND=127.0.0.1
# Plain TCP is accepted ONLY for a loopback hostname/address. A remote AMI service
# must use tls://host:port with a valid trusted certificate; the controller requires
# TLS 1.2+ and normal certificate verification. This image enables loopback TCP;
# remote TLS listener/proxy provisioning is an operator responsibility. Use Node's
# NODE_EXTRA_CA_CERTS for a private CA if needed; never disable verification.
SIPPER_AMI_URL=tcp://127.0.0.1:5038
# Polls run outside call reconciliation every ~10s, with a 5s/4 MiB snapshot limit.
# The portal keeps only opaque account ID, revision, state, time and controller.
# Raw AMI frames may contain passwords and MUST NOT be logged or exported.

# Controller only: portal origin and service key matching portal/.env.example.
# For the packaged controller, use controller.env.example instead of passing this
# complete Asterisk environment (and its database credentials) to that container.
# With the website Worker ingress, use the public HTTPS portal origin so the
# Worker supplies origin authentication. A direct private origin needs a trusted
# ingress proxy that supplies the edge key; the controller does not send it.
# See infra/INGRESS.md. Keep the controller's independent API key below.
# HTTP is accepted only on loopback for local development. Keep the API key out
# of URLs and native apps. APNs/FCM credentials belong to the portal push worker.
# The controller generates a new instance UUID at startup and sends it in the
# X-Sipper-Controller header. The portal grants a 30-second ownership lease,
# renewed every 10 seconds; there is no shared/static instance-ID setting.
# SIGTERM/SIGINT withdraw readiness and wait for active calls before releasing
# ownership. Event and controller process recovery use the durable store below.
# ARI reconnects recheck upstream objects. Asterisk startup times in the journal
# distinguish lost conversations from controller-only recovery; clients must
# re-register and place a new call after Asterisk itself restarts.
# Explicit admin end requests share this reconciliation cycle (normally 10s);
# offline requests wait for recovery and are confirmed only after leg teardown.
# Do not force-kill a draining process
# as a routine deploy; Asterisk/host failure cannot preserve the media itself.
SIPPER_PORTAL_URL=https://management.example.invalid
SIPPER_GATEWAY_API_KEY=
# Required absolute path on a persistent LOCAL filesystem (not NFS or tmpfs).
# The service creates missing parent directories with mode 0700 and the SQLite
# file with mode 0600. An existing immediate parent must already be private.
# Give the service user ownership; mount the whole directory, including SQLite
# WAL/SHM files. Keep this volume across process/container replacement. Do not
# copy only the main database while it is running; use a consistent backup.
# The store is bound to the portal gateway ID, portal origin and private ARI URL.
# Changing any of those requires an explicit migration, not deleting live state.
# It holds opaque call/device/route IDs, transfer stages and pending outcome/end reports;
# no SIP passwords, caller names, destination numbers or media. It is still private
# operational data, not a support export. Completed records are removed on ack.
# A replaced controller cannot write over its successor's state. Storage failure
# pauses new calls and exits; retain/repair the volume before restarting.
# Local example: use an absolute path to gateway/.state/controller.sqlite.
SIPPER_STATE_FILE=/var/lib/sipper-gateway/controller.sqlite
# Exact comma-separated approved upstream server hostnames (not SIP domains).
# Blank keeps the controller running but not ready, with no approved routes.
# Also restrict network egress in the deployment firewall;
# DNS names alone are not an SSRF/network-isolation boundary.
# The current route supports TLS + required SDES SRTP only; unsupported accounts
# are skipped and may not call. Provider and codec interoperability are pending.
SIPPER_UPSTREAM_HOSTS=pbx.example.invalid
