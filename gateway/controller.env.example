# Controller container only. Keep the populated copy outside the checkout, mode
# 0600; Docker administrators can read its environment. Use literal values, not
# shell expansion or surrounding quotes. Never include PBX or database passwords.
# Asterisk transport/database/certificate settings live in gateway/.env.example.

# Public HTTPS portal origin, routed through the website Worker or a trusted
# ingress supplying origin authentication (infra/INGRESS.md). HTTP is permitted
# only on loopback for local tests. This API key must match the portal setting;
# generate an independent random value of at least 32 characters.
SIPPER_PORTAL_URL=https://management.example.invalid
SIPPER_GATEWAY_API_KEY=

# Exact comma-separated upstream server hostnames, not SIP domains or wildcards.
# Also restrict Asterisk network egress; this list does not replace a firewall.
SIPPER_UPSTREAM_HOSTS=pbx.example.invalid

# Share Asterisk's private network namespace so both privileged interfaces stay
# on loopback. Set each password to the matching Asterisk value. Generate separate
# 32+ character secrets, for example with openssl rand -base64 32.
SIPPER_ARI_URL=http://127.0.0.1:8088/ari
SIPPER_ARI_PASSWORD=
# Optional AMI observer: blank disables upstream registration observations.
# The portal then shows Not reported/Stale, never assumed success.
SIPPER_AMI_URL=tcp://127.0.0.1:5038
SIPPER_AMI_PASSWORD=

# Required durable LOCAL volume. Mount the whole directory, including WAL/SHM,
# at this path. It must be owned by container UID 1000 and have mode 0700; the
# journal is 0600. New named volumes inherit these permissions from the image.
# Retain it across controller replacements. Do not use tmpfs/NFS, delete it to
# fix startup, or copy only the active SQLite file. Portal ID/origin and ARI URL
# bind the journal to its gateway; changing them requires a planned migration.
SIPPER_STATE_FILE=/var/lib/sipper-gateway/controller.sqlite

# Optional additional trusted CA for HTTPS portal/ARI or TLS AMI. Mount this
# public certificate read-only and keep normal TLS verification enabled. This is
# distinct from SIPPER_UPSTREAM_CA_FILE, which belongs only to Asterisk.
# NODE_EXTRA_CA_CERTS=/run/secrets/controller-ca.crt
