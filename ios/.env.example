# Native apps use public OAuth clients. Do not put Stripe, gateway, Apple push,
# Firebase service-account, SIP-provider or portal encryption keys in an app build.
# This is a reference for Xcode scheme environment variables; iOS does not read .env files.

# DEBUG only. Normally omit it to use https://sipper.dev.
# ManagedClient accepts HTTP only for localhost/127.0.0.1/::1 in explicit development mode.
# The simulator can reach the Mac's local portal. Physical devices need a trusted HTTPS origin.
SIPPER_MANAGEMENT_URL=https://sipper.dev

# Optional integration test setting. Pass as an xcodebuild build setting, not an app credential.
# Requires tools/sip-test-server.py on 127.0.0.1:5094 using the fictional fixture from README.md.
# Use --auth-algorithm SHA-256 --auth-invite, then repeat with MD5 for compatibility.
# Keep blank for normal app builds. The test refuses any other host.
SIPPER_TEST_REGISTRAR=

# Optional shared direct-SIP DND and network-recovery checks. The fictional registrar
# on 127.0.0.1:5098 must include --answer-special; see tools/sip-test-server.md.
# Pass as an xcodebuild setting. Leave blank for ordinary builds.
SIPPER_TEST_DIRECT_DND=

# The real portal acceptance check is `pnpm test:ios-portal` in portal/.
# It reuses the local test PostgreSQL/Mailpit services and a built portal, creates
# its own simulator from the "Sipper iOS QA" template and deletes it after testing.
# SIPPER_TEST_PORTAL_FILE is supplied automatically as an xcodebuild setting.
# Do not set it for ordinary builds or put real identities/PBX details in fixtures.
# Browser gestures and CallKit system UI remain separate from this native/API check.

# Optional disposable gateway integration test. Set this in the shell when running
# portal/scripts/gateway-smoke.ts (not in an app or production server environment).
# Requires the local sipper_test database, built Asterisk test image and a simulator
# named "Sipper iOS QA" to select the runtime/device type. The harness creates and
# deletes a separate simulator, uses a one-use test CA and never opens a microphone.
# SIPPER_IOS_GATEWAY=1
# SIPPER_TEST_GATEWAY_FILE is supplied automatically by that harness. Do not set it
# for normal builds or put real credentials in its fictional, temporary fixture.

# Library builder settings (shell environment, not Xcode runtime settings).
IPHONEOS_DEPLOYMENT_TARGET=16.0
JOBS=8

# Signing is an Xcode setting. Choose your team for a physical development device;
# simulator builds do not need a Developer ID certificate or notarisation password.
# Use CODE_SIGNING_ALLOWED=YES CODE_SIGN_IDENTITY=- for a runnable simulator build;
# disabling signing removes the Keychain entitlements required by account storage.
# Push settings below are xcodebuild settings (or Xcode build settings), not runtime
# environment variables. This file is documentation; copying it to .env does not enable push.
# Set YES only for a signed app whose explicit App ID has Push Notifications enabled
# and whose provisioning profile includes aps-environment. Default NO keeps local
# simulator builds independent of Apple setup. Never embed provider keys in the app.
SIPPER_PUSH_ENABLED=NO
# The project defaults to development for Debug, production for Release. Match the
# provisioning profile; TestFlight/App Store use production, development installs sandbox.
# SIPPER_APNS_ENVIRONMENT=development
# DEVELOPMENT_TEAM=<your Apple Developer team ID>
# Release: com.hybes.sipper.ios -> server SIPPER_APNS_TOPIC=com.hybes.sipper.ios.voip
# For chat also set server SIPPER_APNS_MESSAGE_TOPIC=com.hybes.sipper.ios.
# Debug: com.hybes.sipper.ios.development -> server topic com.hybes.sipper.ios.development.voip
# Debug chat topic: com.hybes.sipper.ios.development (no .voip suffix).
# Chat uses UIApplication remote-notification tokens and normal UserNotifications
# alerts, independently of PushKit/CallKit. Enable Message notifications under
# Accounts, then grant iOS permission; the app setting defaults off. No body text
# is stored in a notification. Taps only navigate an already owned connection;
# authenticated HTTP checks access before showing any conversation.
# Apply portal migration 034 and run its existing push worker. Firebase is not
# used on iOS; the Apple signing key stays on the server. Real delivery, locked
# devices and permission/tap UI still require a signed physical-device check.
# Server SIPPER_APNS_SANDBOX=true for development, false for distribution. The server
# currently has one APNs topic/environment per deployment. Use a separate staging
# portal/database/gateway for Debug; do not send Debug tokens to production.
# APNs .p8 signing key, key ID and team ID belong only in portal/.env.example's
# server settings. Run the portal push worker and gateway as well as the web server.
# Verify delivery/answer/cancel on a locked physical device before distribution.
